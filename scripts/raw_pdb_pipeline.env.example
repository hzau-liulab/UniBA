# Example config for scripts/run_raw_pdb_feature_pipeline.sh

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON_BIN=python

# Comma-separated dataset names. Each dataset needs:
#   data/PPB-Affinity/<dataset>_pair.txt
#   data/pdb_files/<dataset>/<pair>.pdb
DATASETS=${DATASETS:-ppi,aai,tcr-pmhc}

# Build per-chain PDB/FASTA inputs expected by the legacy feature code from
# data/pdb_files/<dataset>/<pair>.pdb.
RAW_INPUT_PREP_ENABLED=1
RAW_INPUT_PREP_EXTRA_ARGS=

# Optional replacement command when RAW_INPUT_PREP_ENABLED=0.
# DATA_PREP_CMD="python /absolute/path/to/custom_data_preparation.py"

# Sequence / structure embeddings.
MINT_ENABLED=1
MINT_CONFIG="${PROJECT_ROOT}/feature/mint/data/esm2_t33_650M_UR50D.json"
# Download with scripts/download_external_models.sh. Official source:
# https://huggingface.co/varunullanat2012/mint/resolve/main/mint.ckpt
# SHA256: 84a4016365997cd9f0bccb07d746fa8f076ffd8e45aa0cbcf4e50a037161a342
MINT_CHECKPOINT=/absolute/path/to/external_assets/mint/mint.ckpt
MINT_DEVICE=cuda:0

# Generates ESM2 residue features, ESM-IF structure features, handcrafted
# structure features, and distance maps.
SEQ_STR_ENABLED=1
SEQ_STR_CMD_TEMPLATE='cd "{root}" && "{python}" feature/run_seq_str_features.py --project-root "{root}" --data-type "{dataset}" --action generate --esm-path "{esm_path}" --dssp "{dssp}" --ghecom "{ghecom}" --psaia "{psaia}"'
HAND_NORM_CMD_TEMPLATE='cd "{root}" && "{python}" feature/run_seq_str_features.py --project-root "{root}" --data-type "{dataset}" --action normalize --esm-path "{esm_path}" --dssp "{dssp}" --ghecom "{ghecom}" --psaia "{psaia}"'
ESM_PATH=/absolute/path/to/external_assets/esm_cache
DSSP_BIN=/absolute/path/to/mkdssp
GHECOM_BIN=/absolute/path/to/ghecom
# PSAIA is not used by the released 18-dimensional handcrafted feature set.
PSAIA_DIR=

# PLIP interaction features.
PLIP_ENABLED=1
PLIP_BIN=/absolute/path/to/plip
PLIP_OVERWRITE=0

# Energy features require Martini/Gromacs-prepared CG input directories under
# data/affinity_data/cg_input/cg_<dataset>/ plus martini_v2.2.itp. If your raw
# artifact already includes cg_input, leave CG_INPUT_PREP_ENABLED=0. Otherwise,
# provide a local command that creates cg_input for one dataset.
CG_INPUT_PREP_ENABLED=1
MARTINIZE_SCRIPT=/absolute/path/to/martinize.py
MARTINIZE_PYTHON=/absolute/path/to/python2
GMX_BIN=/absolute/path/to/gmx
CG_INPUT_PREP_CMD='cd "{root}" && "{python}" scripts/prepare_martini_cg.py --project-root "{root}" --data-type "{dataset}" --pair-list "{pair_list}" --martinize-script "{martinize}" --python2 "{python2}" --dssp "{dssp}" --gmx "{gmx}" --overwrite'
ENERGY_ENABLED=1
ENERGY_CMD_TEMPLATE='cd "{root}/feature" && UNIBA_PROJECT_ROOT="{root}" UNIBA_DATA_TYPE="{dataset}" UNIBA_PAIR_LIST="{pair_list}" "{python}" get_energy_feature.py'

# Graph generation.
RES_GRAPH_ENABLED=1
CG_GRAPH_ENABLED=1
CDR_JSON="${PROJECT_ROOT}/data/cdr_sequences.json"
LABEL_JSON="${PROJECT_ROOT}/data/affinity_data/all_data_with_multi_labels.json"
CG_GRAPH_MODE=both

STOP_ON_MISSING=1
